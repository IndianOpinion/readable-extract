<?xml version="1.0"?>
<ruleset name="readable-extract">
    <description>PSR-12 for readable-extract.</description>
    <file>src</file>
    <file>tests</file>
    <file>bin</file>
    <file>examples</file>
    <file>bootstrap.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <!-- Stream wrapper methods have names fixed by PHP. -->
        <exclude-pattern>tests/Support/NoNetwork.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>bootstrap.php</exclude-pattern>
        <exclude-pattern>bin/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
</ruleset>
